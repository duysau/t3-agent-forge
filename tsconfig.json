{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts"
  ],
  // `public` bị loại vì `checkJs: true` cùng mẫu include cho file .js kéo cả asset
  // tĩnh vào diện typecheck. `public/voice/mic-worklet.js` chạy trong
  // AudioWorkletGlobalScope, mà `AudioWorkletProcessor`, `registerProcessor` và
  // `sampleRate` KHÔNG nằm trong lib `dom` (chúng ở package `@types/audioworklet`
  // riêng) — nên tsc báo lỗi cho một file hoàn toàn đúng. File đó không đi qua
  // bundler và được kiểm bằng chính test nạp nó
  // (`src/lib/voice/mic-worklet.test.ts`), nên nó không phải vùng không ai kiểm.
  "exclude": ["node_modules", "generated", "public"]
}
