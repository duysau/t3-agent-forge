# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env-schema.ts"
# should be updated accordingly.

# Domain công khai, dùng cho metadataBase / sitemap.xml / robots.txt / OG card.
# Tuỳ chọn: KHÔNG nằm trong env-schema.js nên thiếu cũng không làm build/dev chết.
# Thứ tự fallback (src/lib/site.ts): biến này → URL Vercel tự cấp → domain
# production mặc định (khi NODE_ENV=production) → http://localhost:3000.
# Chỉ cần set khi chạy sau một domain riêng.
# NEXT_PUBLIC_SITE_URL="https://agentforge.fptsmartcloud.vn"

DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/agentforge"
PYTHON_API_URL="http://127.0.0.1:8444"
NEXT_PUBLIC_PYTHON_WS_URL="ws://127.0.0.1:8444"
FALLBACK_TO_FIXTURE="true"
CRAWL_MAX_PAGES="5"
